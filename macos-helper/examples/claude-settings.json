{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" idle",
            "timeout": 5
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" working",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" working",
            "timeout": 5
          }
        ],
        "matcher": "^(?!AskUserQuestion$|ExitPlanMode$).*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" input",
            "timeout": 5
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" working",
            "timeout": 5
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" input",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" input",
            "timeout": 5
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" done",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Application Support/Moonside Agent Lamp/moonside_hook.sh\" off",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
